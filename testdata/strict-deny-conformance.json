      "expected": {"decision": "deny", "reason": "kill_switch_active", "allowed": false, "pdp_unavailable": false}
    },
    {
      "name": "kill_switch_active_unregistered",
      "http_status": 403,
      "body": {"decision": "deny", "reason": "kill_switch_active"},
      "expected": {"decision": "deny", "reason": "kill_switch_active", "allowed": false, "pdp_unavailable": false}
    },
