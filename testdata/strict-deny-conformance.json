      "http_status": 403,
      "body": {"decision": "deny", "reason": "default_deny_future_reason", "decisionId": "dec_strict_2"},
      "expected": {"decision": "deny", "reason": "default_deny_future_reason", "allowed": false, "pdp_unavailable": false}
    },
    {
